# Бэкенд CMS (все значения только серверные, в клиентский бандл не попадают).
# CMS (crito-api) на проде живёт на https://edu.mipt.ru/adm/cms-admin (админка) и
# https://edu.mipt.ru/adm/cms-admin/cms-api (API).
# Публичный адрес чтения страниц crito-api: <api>/public/<project>.
# Прод: https://edu.mipt.ru/adm/cms-admin/cms-api/public/rucode
# Локально: http://127.0.0.1:3000/public/rucode (npm run api в crito-api).
# Сайт запрашивает {NUXT_CMS_BASE_URL}/pages/{slug} (главная — index). Любая ошибка, кроме 404, даёт 502
# «CMS недоступна» на /api/cms/<slug>. Без значения используются локальные данные.
NUXT_CMS_BASE_URL=
# Корень API CMS (без завершающего слэша) для /cms-api/media/** и PUT /cms-api/projects/<project>/manifest.
# Обязателен, пока API стоит под префиксом: прод https://edu.mipt.ru/adm/cms-admin/cms-api.
# Пусто: берётся происхождение NUXT_CMS_BASE_URL (годится только для API в корне хоста).
NUXT_CMS_API_URL=
# Секрет вебхука POST /api/revalidate (заголовок x-revalidate-secret)
NUXT_REVALIDATE_SECRET=
# Время жизни серверного кэша страниц, секунды
NUXT_CMS_CACHE_TTL=60

# Прокси админки CMS: https://<сайт>/cms-admin/ (временное решение для демонстрации).
# На проде не нужен: админка размещена на https://edu.mipt.ru/adm/cms-admin/, оставьте значения пустыми.
# Доступ по basic auth: без логина и пароля путь отвечает 404, админка на сайте недоступна.
# Админка CMS должна быть собрана и запущена с NUXT_APP_BASE_URL=/cms-admin/.
NUXT_CMS_ADMIN_USER=
NUXT_CMS_ADMIN_PASSWORD=
NUXT_CMS_ADMIN_UPSTREAM=http://127.0.0.1:3100

# Предпросмотр правок из админки CMS: адреса админки через запятую (пусто: любое родительское окно).
# Прод: https://edu.mipt.ru
NUXT_PUBLIC_PREVIEW_ADMIN_ORIGINS=
